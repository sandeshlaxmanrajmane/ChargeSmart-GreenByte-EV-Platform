# ChargeSmart — Smart EV Charging & Renewable Energy Optimization
# Environment Configuration

# Server Port (Default: 8000)
PORT=8000

# Open Charge Map API Key (Optional)
# If provided, enables additional global charging station metadata from Open Charge Map API v3.
# Register for a free API key at: https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_API_KEY=

# Electricity Maps API Token (Optional)
# If provided, enables live zonal grid carbon intensity and real-time generation breakdown.
# Register at: https://www.electricitymaps.com/free-tier
ELECTRICITY_MAPS_API_KEY=

# OpenStreetMap Nominatim User Agent (Recommended)
NOMINATIM_USER_AGENT=ChargeSmart-EV-Platform/2.5 (contact@greenbyte.energy)

# Client Vite Configuration
VITE_API_URL=/api
VITE_OPEN_CHARGE_MAP_KEY=
